{
  "name": "finale-support-backend",
  "version": "1.0.0",
  "description": "Finale Support backend scaffold generated by script (API + Workers merged)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/seed/initialData.js",
    "saas:seed": "node src/saas/seed/index.js",
    "seed:all": "node src/seed/initialData.js && node src/saas/seed/index.js",
    "start:workers": "pm2 start pm2.worker.config.js",
    "hard-delete-worker": "node src/saas/workers/hardDeleteWorker.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "lint": "eslint src --ext .js"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.0",
    "moment": "^2.30.1",
    "mongoose": "^7.4.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.10.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pm2": "^6.0.14",
    "razorpay": "^2.9.6",
    "redis": "^4.6.7",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "jest": "^29.6.0",
    "mongodb-memory-server": "^8.12.1",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.3"
  }
}
